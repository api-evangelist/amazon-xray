          "request": {
            "name": "Amazon X-Ray Put Resource Policy",
            "description": {
              "content": " Sets the resource policy to grant one or more Amazon Web Services services and accounts permissions to access X-Ray. Each resource policy will be associated with a specific Amazon Web Services account. Each Amazon Web Services account can have a maximum of 5 resource policies, and each policy name must be unique within that account. The maximum size of each resource policy is 5KB. ",
              "type": "text/plain"
            },
