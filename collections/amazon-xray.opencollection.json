{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon X-Ray API",
    "version": "2016-04-12"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
