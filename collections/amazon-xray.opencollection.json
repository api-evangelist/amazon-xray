          "info": {
            "name": "Amazon X-Ray Upload trace segments",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://xray.{region}.amazonaws.com/Traces",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Uploads segment documents to AWS X-Ray."
        },
        {
          "info": {
            "name": "Amazon X-Ray Get trace summaries",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://xray.{region}.amazonaws.com/TraceSummaries",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves IDs and annotations for traces available for a specified time frame using an optional filter."
        }
      ]
    },
    {
      "info": {
        "name": "Service Graph",
        "type": "folder"
      },
